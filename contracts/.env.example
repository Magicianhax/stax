# Deployer key. Use a throwaway key; it needs a little gas on the target chain
# (~0.002 ETH on Base covers the 3 deploys + whitelist txs; a small MNT balance on Mantle).
PRIVATE_KEY=

# RPCs — Base (primary)
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# RPCs — Mantle
MANTLE_RPC_URL=https://rpc.mantle.xyz
MANTLE_SEPOLIA_RPC_URL=https://rpc.sepolia.mantle.xyz

# Etherscan API key (V2 multichain — one key covers Basescan + Mantlescan verification, free tier) — https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Off-chain agent signer (the EIP-712 risk-inference signer; its address is set as trusted in InferenceVerifier)
AGENT_SIGNER_ADDRESS=

# Vera's agent card, stored as the IdentityRegistry tokenURI (optional; defaults to stax.best)
AGENT_CARD_URI=https://stax.best/.well-known/agent-card.json

# --- enable:base (after deploy:base) ---
# Deployed StaxExecutor on Base, printed by deploy:base.
# Resume a partial Base deploy: set any of these to reuse contracts already deployed by a previous run.
INFERENCE_VERIFIER_BASE=
IDENTITY_REGISTRY_BASE=
STAX_EXECUTOR_BASE=
STAX_EXECUTOR_BLOCK_BASE=
# Extra token addresses to whitelist, comma-separated (e.g. a newly liquid Coinbase stock not yet in scripts/base-addresses.js).
EXTRA_ASSETS=
