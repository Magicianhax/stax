# Stax web env — committed template. Copy to .env.local and fill in. Do NOT put real secrets here.

# Chains. Stax is multi-chain: Base (8453) is the DEFAULT, Mantle (5000) is the
# legacy mode. The user switches in Settings; API routes read `x-stax-chain` /
# `?chain=`. Token + router addresses live in code (src/lib/chains/{base,mantle}.ts);
# only RPC URLs and the deployed Stax contract addresses come from env.

# Base (default). Contract vars are filled by `contracts/scripts/deploy-base.js`.
# Until NEXT_PUBLIC_STAX_EXECUTOR_BASE is set, Base shows a calm "being switched on"
# state and /api/invest-plan returns 503 for Base instead of firing calls.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_STAX_EXECUTOR_BASE=
NEXT_PUBLIC_INFERENCE_VERIFIER_BASE=
NEXT_PUBLIC_IDENTITY_REGISTRY_BASE=
NEXT_PUBLIC_STAX_AGENT_ID_BASE=1
# Block the Base executor was deployed at (bounds event-log scans: history/activity).
NEXT_PUBLIC_STAX_EXECUTOR_BLOCK_BASE=

# Mantle (legacy mode). Defaults to the live mainnet deployment if unset.
NEXT_PUBLIC_MANTLE_RPC_URL=https://rpc.mantle.xyz

# Privy — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Pimlico — https://dashboard.pimlico.io (one key; the proxy hits v2/<chainId>/rpc per chain)
PIMLICO_API_KEY=

# Alchemy (server-side) — https://dashboard.alchemy.com (enable Base Mainnet and/or
# Mantle Mainnet on the app). Fallback for the Wallet transaction history (ERC-20
# log scan; PAYG plans only) when ETHERSCAN_API_KEY is unset. The network slug is
# derived per chain (base-mainnet / mantle-mainnet). To route client reads through
# Alchemy too, set NEXT_PUBLIC_BASE_RPC_URL / NEXT_PUBLIC_MANTLE_RPC_URL to
# https://<network>.g.alchemy.com/v2/<key>.
ALCHEMY_API_KEY=

# Transak — https://transak.com
NEXT_PUBLIC_TRANSAK_API_KEY=
NEXT_PUBLIC_TRANSAK_ENVIRONMENT=STAGING

# Coinbase Onramp / Offramp ("Add money" / "Cash out" on Wallet) — the CDP project
# id from https://portal.cdp.coinbase.com (Onramp must be enabled on the project and
# the app's domain allowlisted). Base only. Unset → Wallet keeps the plain
# receive/QR flow. The server-minted session-token init is the infra follow-up
# (see src/lib/onramp.ts).
NEXT_PUBLIC_CDP_PROJECT_ID=

# AI via direct Anthropic API — https://console.anthropic.com (sk-ant-...)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Stax AI agent EIP-712 signer (server-only) — generate with: see contracts/scripts genSigner.
# One key signs on every chain; the EIP-712 domain (chainId + verifier) is per chain.
AGENT_SIGNER_PRIVATE_KEY=

# Mantle deployed contract addresses (from the Mantle deploy script). Optional:
# the code defaults to the live Mantle deployment when these are unset.
NEXT_PUBLIC_STAX_EXECUTOR=
NEXT_PUBLIC_INFERENCE_VERIFIER=
NEXT_PUBLIC_IDENTITY_REGISTRY=
NEXT_PUBLIC_STAX_AGENT_ID=
# Block the Mantle executor was deployed at (bounds event-log scans: history/activity).
NEXT_PUBLIC_STAX_EXECUTOR_BLOCK=

# Etherscan V2 API key (free) — https://etherscan.io/myapikey. One key works across
# chains: Base (chainid 8453) and Mantle (chainid 5000). Powers the Wallet
# transaction history + executor log scans (indexed, no block-range limits).
ETHERSCAN_API_KEY=

# Autopilot (autonomous delegated agent). TEE wallets: the client grants the
# server's signer as a SESSION SIGNER, and the server signs with the matching
# authorization private key.
#   NEXT_PUBLIC_PRIVY_SIGNER_ID — the signer / key-quorum ID (Privy dashboard → Wallet API signers)
#   PRIVY_AUTHORIZATION_KEY     — that signer's private key (base64 PKCS8), server-only
NEXT_PUBLIC_PRIVY_SIGNER_ID=
PRIVY_AUTHORIZATION_KEY=
AUTOPILOT_CRON_SECRET=

# Supabase — Autopilot store + audit log + pg_cron scheduler (supabase.com).
# Run supabase/migrations/0001_autopilot.sql then 0002_autopilot_chain.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
# SECRET key (sb_secret_…, replaces service_role) — SERVER ONLY, bypasses RLS.
# NEVER prefix with NEXT_PUBLIC_ (that would leak it to the browser).
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_…) — public/browser; optional, not used server-side.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Platform fee — basis points on capital deployed (buys + AI invests). 25 = 0.25%.
# Treasury receives the fee (defaults to the deployer if unset).
NEXT_PUBLIC_STAX_FEE_BPS=25
NEXT_PUBLIC_STAX_TREASURY=
